# LegalEdu Manager — environment variables
# Copy to .env.local (never commit real values). Every variable is optional:
# with no Supabase values the app runs in clearly-labelled DEMO MODE with
# fictional data stored in ./.data (NOT a production database).

# ---------------------------------------------------------------------------
# Supabase (production backend: PostgreSQL + Auth + private Storage)
# ---------------------------------------------------------------------------
# Project URL and anon/publishable key (Project Settings → API). These are
# designed to be public; security comes from row-level security policies.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key: ONLY for the offline scripts (seed:supabase, retention).
# The web app never uses it. Never expose it to the browser or commit it.
SUPABASE_SERVICE_ROLE_KEY=

# ---------------------------------------------------------------------------
# AI-assisted review (optional; server-side only, never sent to the browser)
# Configure one, both, or neither. Missing keys simply disable live AI review.
# ---------------------------------------------------------------------------
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
GEMINI_API_KEY=
# Check Google's current model list and set the model your account can use.
GEMINI_MODEL=gemini-2.5-pro
AI_TIMEOUT_SECONDS=120
AI_DAILY_LIMIT=30
AI_MAX_DOCUMENT_CHARS=60000

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
MAX_UPLOAD_MB=20
MAX_FILES_PER_SUBMISSION=5

# ---------------------------------------------------------------------------
# Privacy / retention (see docs/PRIVACY-AND-RETENTION.md)
# ---------------------------------------------------------------------------
# Shown in Settings and used by `npm run retention`. Leave empty to keep data
# until deleted manually.
DATA_RETENTION_DAYS=
RETENTION_ACTOR_ID=

# Display time zone for dates (IANA name)
NEXT_PUBLIC_APP_TIMEZONE=Asia/Tashkent

# ---------------------------------------------------------------------------
# Demo mode only
# ---------------------------------------------------------------------------
# Password for the fictional demo accounts (default: demo-2026)
DEMO_PASSWORD=
# 32+ random chars to sign demo session cookies (auto-generated into .data if empty)
DEMO_SESSION_SECRET=
# Where demo data is stored (default ./.data)
DEMO_DATA_DIR=
